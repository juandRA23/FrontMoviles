<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FrontMoviles.ChatPage"
             Title="Chat"
             BackgroundColor="#F8F9FA"
             Shell.NavBarIsVisible="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Lista de mensajes -->
        <ScrollView Grid.Row="0" 
                    x:Name="MessagesScrollView"
                    Padding="10,10,10,5">
            <StackLayout x:Name="MessagesContainer" 
                         Spacing="10">
                <!-- Los mensajes se agregan dinámicamente aquí -->
            </StackLayout>
        </ScrollView>

        <!-- Barra de escritura -->
        <Frame Grid.Row="1" 
               BackgroundColor="White"
               CornerRadius="0"
               HasShadow="True"
               Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Frame Grid.Column="0"
                       BackgroundColor="#F5F5F5"
                       CornerRadius="20"
                       HasShadow="False"
                       Padding="15,10"
                       Margin="0,0,10,0">
                    <Entry x:Name="MessageEntry"
                           Placeholder="Escribe un mensaje..."
                           PlaceholderColor="Gray"
                           TextColor="Black"
                           BackgroundColor="Transparent"
                           FontSize="16"
                           Completed="OnSendMessageClicked" />
                </Frame>

                <Button Grid.Column="1"
                        x:Name="SendButton"
                        Text="Enviar"
                        BackgroundColor="#4A7C59"
                        TextColor="White"
                        CornerRadius="20"
                        FontAttributes="Bold"
                        WidthRequest="80"
                        HeightRequest="40"
                        Clicked="OnSendMessageClicked" />
            </Grid>
        </Frame>

        <!-- Indicador de carga -->
        <Frame Grid.Row="0" 
               x:Name="LoadingFrame"
               BackgroundColor="#80000000"
               IsVisible="False"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               CornerRadius="10"
               Padding="20">
            <StackLayout Orientation="Horizontal" Spacing="10">
                <ActivityIndicator IsRunning="True" Color="White" />
                <Label Text="Cargando mensajes..." TextColor="White" FontSize="16" />
            </StackLayout>
        </Frame>
    </Grid>
</ContentPage>